# Copy to .env and fill in to connect eBay. Not needed for local/simulate use.

PORT=8787
EBAY_ENV=production            # or: sandbox

# App keys from https://developer.ebay.com  (Application Keys page)
EBAY_DEV_ID=
EBAY_APP_ID=
EBAY_CERT_ID=

# RuName (redirect URL name) you create in the dev portal. Its accept URL must
# point to  <PUBLIC_URL>/ebay/accepted  and decline URL to /ebay/declined.
EBAY_RUNAME=

# Public URL of THIS deployed server (no trailing slash), e.g. https://xyz.onrender.com
# Used to build the eBay webhook + overlay URLs and the OAuth redirect.
PUBLIC_URL=

# The seller token is normally obtained via the "Connect eBay" button and saved
# to token.json automatically. You can also paste one here to skip that.
EBAY_AUTH_TOKEN=

# Only for the REST "marketplace account deletion" verification (32–80 chars).
EBAY_VERIFICATION_TOKEN=change-me-to-a-32-to-80-char-random-token
